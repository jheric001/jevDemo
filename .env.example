TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional, used by the Traditional Chinese console at /zh
# TRANSLATE_MODEL=google/gemini-2.5-flash-lite   # defaults to TEXT_MODEL
# JEV_PREPAID_USD=20                              # prepaid TypeSafe balance, for the local "remaining" estimate
# JEV_USD_PER_MTOK=0.042                          # Jev input price per million tokens
# ---- v2 web research assistant ----
# TYPESAFE_DEMO_PORT=8767
# PLANNER_MODEL=anthropic/claude-sonnet-5      # understands and decomposes the Chinese task
# JUDGE_MODEL=google/gemini-2.5-flash          # filters candidates, extracts record fields, writes the report
# ASSISTANT_MAX_ITEMS=20                        # captures per task
